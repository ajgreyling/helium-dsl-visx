{
  "name": "helium-dsl-vscode",
  "displayName": "Helium Rapid DSL (ANTLR4)",
  "version": "1.30.1774363296",
  "publisher": "mezzanineware",
  "readme": "./README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajgreyling/helium-dsl-visx.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:helium-vxml",
    "workspaceContains:**/model/**/*.mez",
    "workspaceContains:**/web-app/presenters/**/*.mez",
    "onCommand:heliumDsl.lintCurrentFile",
    "onCommand:heliumDsl.lintWorkspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "heliumDsl.lintCurrentFile",
        "title": "Lint Current File",
        "category": "Helium Rapid DSL"
      },
      {
        "command": "heliumDsl.lintWorkspace",
        "title": "Lint Current Project",
        "category": "Helium Rapid DSL"
      }
    ],
    "configuration": {
      "title": "Helium Rapid DSL (ANTLR4)",
      "properties": {
        "heliumDsl.lint.noVarInElse": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info",
            "off"
          ],
          "default": "error",
          "description": "Variables cannot be declared in else blocks."
        },
        "heliumDsl.lint.namingConventions": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info",
            "off"
          ],
          "default": "warning",
          "description": "Naming conventions enforcement."
        },
        "heliumDsl.dslCommonsPath": {
          "type": "string",
          "default": "",
          "description": "Path to appexec-dsl-commons repo. Required for role/platform/blob implicit field validation (mined from BuiltinObjects.java and ObjectBuilder.java). Can also be set via DSL_COMMONS_PATH env var."
        }
      }
    },
    "languages": [
      {
        "id": "helium-dsl",
        "aliases": [
          "Helium Rapid DSL (ANTLR4)",
          "helium-dsl"
        ],
        "extensions": [
          ".mez"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "helium-vxml",
        "aliases": [
          "Helium VXML",
          "helium-vxml"
        ],
        "extensions": [
          ".vxml"
        ],
        "configuration": "./vxml-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "helium-dsl",
        "scopeName": "source.helium-dsl",
        "path": "./generated/syntaxes/helium-dsl.tmLanguage.json"
      },
      {
        "language": "helium-vxml",
        "scopeName": "text.xml.helium-vxml",
        "path": "./generated/syntaxes/helium-vxml.tmLanguage.json"
      },
      {
        "scopeName": "text.xml.helium-vxml.inject",
        "path": "./generated/syntaxes/helium-vxml-inject.tmLanguage.json",
        "injectTo": [
          "text.xml",
          "text.xml.derivative",
          "text.xml.helium-vxml"
        ]
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "helium-vxml",
        "scopes": {
          "helVxmlUnit": [
            "entity.name.type.helium.vxml.unit"
          ],
          "helVxmlInit": [
            "entity.name.function.helium.vxml.init"
          ],
          "helVxmlFn": [
            "entity.name.function.helium.vxml.bindfn"
          ],
          "helVxmlVar": [
            "variable.other.helium.vxml.bindvar"
          ],
          "helVxmlAttr": [
            "support.variable"
          ]
        }
      }
    ],
    "iconThemes": [
      {
        "id": "helium-icons",
        "label": "Helium Icons",
        "path": "./helium-icons.json"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "heliumRapidDsl",
        "label": "Helium Rapid DSL MCP Server"
      }
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf out",
    "watch": "tsc -b -w",
    "package": "bash ../helium-vscode-tooling/scripts/package-local.sh",
    "test": "echo \"No tests yet\""
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "adm-zip": "^0.5.16",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
