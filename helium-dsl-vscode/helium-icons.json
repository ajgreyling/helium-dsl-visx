{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode/main/extensions/theme-seti/icons/vs-seti-icon-theme.json",
  "iconDefinitions": {
    "helium-mez": {
      "iconPath": "./icons/file-code.svg"
    },
    "helium-vxml": {
      "iconPath": "./icons/file-xml-box.svg"
    },
    "helium-model": {
      "iconPath": "./icons/database.svg",
      "fontColor": {
        "light": "#333333",
        "dark": "#CCCCCC"
      }
    },
    "helium-services": {
      "iconPath": "./icons/server.svg",
      "fontColor": {
        "light": "#333333",
        "dark": "#CCCCCC"
      }
    },
    "helium-presenters": {
      "iconPath": "./icons/presentation.svg",
      "fontColor": {
        "light": "#333333",
        "dark": "#CCCCCC"
      }
    },
    "helium-utilities": {
      "iconPath": "./icons/wrench.svg",
      "fontColor": {
        "light": "#333333",
        "dark": "#CCCCCC"
      }
    },
    "helium-web-app": {
      "iconPath": "./icons/web.svg",
      "fontColor": {
        "light": "#333333",
        "dark": "#CCCCCC"
      }
    },
    "helium-views": {
      "iconPath": "./icons/eye.svg",
      "fontColor": {
        "light": "#333333",
        "dark": "#CCCCCC"
      }
    },
    "helium-jasper-reports": {
      "iconPath": "./icons/chart-bar.svg",
      "fontColor": {
        "light": "#333333",
        "dark": "#CCCCCC"
      }
    },
    "helium-builtin-reports": {
      "iconPath": "./icons/file-document-multiple.svg",
      "fontColor": {
        "light": "#333333",
        "dark": "#CCCCCC"
      }
    }
  },
  "fileExtensions": {
    ".mez": "helium-mez",
    ".vxml": "helium-vxml"
  },
  "folderNames": {
    "model": "helium-model",
    "services": "helium-services",
    "presenters": "helium-presenters",
    "utilities": "helium-utilities",
    "web-app": "helium-web-app",
    "views": "helium-views",
    "jasper-reports": "helium-jasper-reports",
    "builtin-reports": "helium-builtin-reports"
  },
  "folderNamesExpanded": {
    "model": "helium-model",
    "services": "helium-services",
    "presenters": "helium-presenters",
    "utilities": "helium-utilities",
    "web-app": "helium-web-app",
    "views": "helium-views",
    "jasper-reports": "helium-jasper-reports",
    "builtin-reports": "helium-builtin-reports"
  }
}
