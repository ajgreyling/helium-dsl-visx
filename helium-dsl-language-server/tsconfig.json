{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "outDir": "out",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "../node_modules/@types", "./src/parser"]
  },
  "include": ["src/**/*", "tests/**/*", "generated/**/*"],
  "exclude": ["out", "node_modules"]
}

