{
  "name": "helium-dsl-language-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/server.js",
  "types": "out/server.d.ts",
  "exports": {
    ".": {
      "types": "./out/server.d.ts",
      "default": "./out/src/server.js"
    },
    "./api": {
      "default": "./out/src/api.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf out",
    "watch": "tsc -b -w",
    "test": "NODE_OPTIONS='--loader ts-node/esm' mocha tests/**/*.test.ts"
  },
  "dependencies": {
    "antlr4ts": "^0.5.0-alpha.4",
    "fs-extra": "^11.2.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@types/chai": "^4.3.12",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.9",
    "chai": "^4.4.1",
    "mocha": "^10.7.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "ts-node": {
    "esm": true,
    "compilerOptions": {
      "module": "ES2020",
      "moduleResolution": "node"
    }
  }
}
