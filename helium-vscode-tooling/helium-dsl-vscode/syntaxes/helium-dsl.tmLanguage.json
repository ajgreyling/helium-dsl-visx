{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Helium DSL",
  "scopeName": "source.helium-dsl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#language-constants"
    },
    {
      "name": "keyword.control.helium",
      "match": "\\b(unit|validator|object|persistent|enum|foreach|for|if|else|return)\\b"
    },
    {
      "name": "storage.type.primitive.helium",
      "match": "\\b(int|decimal|bigint|uuid|blob|bool|string|void|date|datetime|json|jsonarray)\\b"
    },
    {
      "name": "meta.object.definition.persistent.helium",
      "begin": "\\b(persistent)\\s+(object)\\s+",
      "end": "\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.helium"
        },
        "2": {
          "name": "keyword.control.helium"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.helium"
        }
      },
      "patterns": [
        {
          "name": "entity.name.type.class.helium",
          "match": "\\b([A-Za-z_][a-zA-Z0-9_]*)\\b"
        }
      ]
    },
    {
      "name": "meta.object.definition.helium",
      "begin": "\\b(object)\\s+",
      "end": "\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.helium"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.helium"
        }
      },
      "patterns": [
        {
          "name": "entity.name.type.class.helium",
          "match": "\\b([A-Za-z_][a-zA-Z0-9_]*)\\b"
        }
      ]
    },
    {
      "name": "meta.unit.definition.helium",
      "begin": "\\b(unit)\\s+",
      "end": "\\s*;",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.helium"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.helium"
        }
      },
      "patterns": [
        {
          "name": "entity.name.type.namespace.helium",
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\b"
        }
      ]
    },
    {
      "name": "meta.enum.definition.helium",
      "begin": "\\b(enum)\\s+",
      "end": "\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.helium"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.helium"
        }
      },
      "patterns": [
        {
          "name": "entity.name.type.enum.helium",
          "match": "\\b([A-Z_][A-Z0-9_]*)\\b"
        }
      ]
    },
    {
      "name": "meta.function.definition.helium",
      "begin": "\\b(int|decimal|bigint|uuid|blob|bool|string|void|date|datetime|json|jsonarray)\\s+([a-z_][a-zA-Z0-9_]*)\\s*\\(",
      "end": "\\)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "storage.type.primitive.helium"
        },
        "2": {
          "name": "entity.name.function.helium"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.helium"
        }
      },
      "patterns": [
        {
          "include": "#function-parameters"
        }
      ]
    },
    {
      "name": "meta.variable.declaration.helium",
      "match": "\\b(int|decimal|bigint|uuid|blob|bool|string|void|date|datetime|json|jsonarray)\\s+([a-z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "storage.type.primitive.helium"
        },
        "2": {
          "name": "variable.other.helium"
        }
      }
    },
    {
      "name": "support.function.helium",
      "match": "\\b(Mez|sql|String|Math|Date|Integer|Decimal|Uuid|api):[a-zA-Z_][a-zA-Z0-9_]*\\b"
    },
    {
      "name": "meta.unit.reference.helium",
      "match": "\\b([A-Z][A-Za-z0-9_]*):([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "entity.name.type.namespace.helium"
        },
        "2": {
          "name": "entity.name.function.helium"
        }
      }
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.helium",
          "match": "//.*$"
        },
        {
          "name": "comment.block.helium",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.helium",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.block.helium",
          "begin": "/%",
          "end": "%/"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.helium",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.helium",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.helium",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "language-constants": {
      "patterns": [
        {
          "name": "constant.language.helium",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.helium",
          "match": "==|!=|>=|<="
        },
        {
          "name": "keyword.operator.comparison.helium",
          "match": "[><]"
        },
        {
          "name": "keyword.operator.arithmetic.helium",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.assignment.helium",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.helium",
          "match": ","
        },
        {
          "name": "punctuation.terminator.helium",
          "match": ";"
        },
        {
          "name": "punctuation.accessor.helium",
          "match": "\\."
        }
      ]
    },
    "function-parameters": {
      "patterns": [
        {
          "name": "variable.parameter.helium",
          "match": "\\b(int|decimal|bigint|uuid|blob|bool|string|void|date|datetime|json|jsonarray|[A-Z_][A-Z0-9_]*)\\s+([a-z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.helium"
            },
            "2": {
              "name": "variable.parameter.helium"
            }
          }
        },
        {
          "include": "#punctuation"
        }
      ]
    }
  },
  "fileTypes": [
    "mez"
  ],
  "uuid": "a0416cfa-4b07-44d4-9f7a-8ad7f3f1b0f1"
}
